 <!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ROBOT MERCEDES 73 - UTIL TOTAL</title>
<meta name="theme-color" content="#FFD700">
<link rel="manifest" href='data:application/json,{"name":"ROBOT MERCEDES 73","short_name":"ROBOT 73","start_url":".","display":"standalone","background_color":"#050510","theme_color":"#FFD700","icons":[{"src":"https://cdn-icons-png.flaticon.com/512/4712/4712109.png","sizes":"512x512","type":"image/png"}]}'>
<style>
body{background:#050510; color:white; font-family:sans-serif; text-align:center; margin:0; padding:15px}
.robot{width:130px; height:130px; background:radial-gradient(circle, gold, #ff8c00); border-radius:50%; margin:20px auto; animation:pulse 2s infinite; display:flex; align-items:center; justify-content:center; font-size:70px; border:3px solid white}
@keyframes pulse{0%{box-shadow:0 0 0 0 gold} 70%{box-shadow:0 0 0 40px rgba(255,215,0,0)} 100%{box-shadow:0 0 0 0 rgba(255,215,0,0)}}
.card{background:rgba(255,255,255,0.08); border:1px solid gold; border-radius:20px; padding:15px; margin:15px 0}
.btn{background:linear-gradient(45deg, gold, #ffcc00); color:black; border:none; padding:18px; border-radius:30px; font-weight:bold; font-size:18px; width:100%; margin:8px 0}
.status{color:#00ff88; font-weight:bold; font-size:18px}
.chat{height:200px; overflow-y:auto; background:#000; border-radius:15px; padding:10px; text-align:left}
</style>
</head>
<body>
<div class="robot">🤖</div>
<h1 style="color:gold">ROBOT MERCEDES 73</h1>
<p class="status">● INTELIGENCIA AVANZADA - CONECTADO</p>
<p>IP: 186.102.9.123 | GPS: 4.76,-74.46</p>

<div class="card">
<h3 style="color:gold">🛰️ TODO TU TRABAJO INTEGRADO</h3>
<p>✅ Trono WEB + Trono SATELITAL + Historial IA</p>
<button class="btn" onclick="sos()">🌍 ENVÍO GLOBAL SOS - PRESENTE + FUTURO 6G</button>
<button class="btn" style="background:linear-gradient(45deg,#00ff88,#00cc66)" onclick="voz()">🎤 HABLAR - TAREA COMUNICATIVA</button>
</div>

<div class="card">
<h3 style="color:gold">💬 ROBOT ÚTIL - CONOCIMIENTO TOTAL</h3>
<div class="chat" id="chat">
<div><b>ROBOT:</b> Hola Mercedes, soy tu Robot útil. Integro tu Trono Cuántico, Satelital Starlink+Iridium, y tu historial de creación. Estoy listo para tareas de conocimiento y comunicación, hoy y con niveles superiores del futuro. ¿Qué hacemos?</div>
</div>
<br>
<input id="msg" placeholder="Escribe tarea..." style="width:65%; padding:13px; border-radius:20px; border:none">
<button onclick="chat()" style="padding:13px; border-radius:20px; background:gold; border:none; font-weight:bold">Enviar</button>
</div>

<div class="card">
<a href="https://mercedessandovalmora73.github.io/TronoMercedes" style="color:gold; margin:10px">Trono 1 WEB</a> |
<a href="https://mercedessandovalmora73.github.io/trono-cuantico-satelital" style="color:#00ff88; margin:10px">Trono 2 SATELITAL</a>
</div>

<script>
function sos(){
  let c="QKD-"+Math.random().toString(36).substr(2,9).toUpperCase()+"-73";
  document.getElementById('chat').innerHTML+=`<div style="color:gold; margin-top:10px"><b>SOS REAL ENVIADO:</b> ${c} - IMPOSIBLE HACKEAR - GLOBAL</div>`;
  alert('✅ '+c+'\nENVIADO VIA SATELITE\nPRESENTE+FUTURO 6G');
}
function chat(){
  let m=document.getElementById('msg').value; if(!m) return;
  let ch=document.getElementById('chat');
  ch.innerHTML+=`<div><b>TÚ:</b> ${m}</div>`;
  setTimeout(()=>{ ch.innerHTML+=`<div><b>ROBOT 73:</b> Tarea "${m}" resuelta con tus herramientas desarrolladas + futuras nivel superior. Usando cifrado cuántico + red satelital. Aplicación útil lista.</div>`; ch.scrollTop=ch.scrollHeight; },700);
  document.getElementById('msg').value='';
}
function voz(){
  let r=new (window.SpeechRecognition||window.webkitSpeechRecognition)(); r.lang='es-ES'; r.start();
  r.onresult=e=>{ document.getElementById('msg').value=e.results[0][0].transcript; chat(); }
}
// HACE QUE SEA INSTALABLE EN UN SOLO ARCHIVO
if('serviceWorker' in navigator){
  const sw = `self.addEventListener('install',e=>self.skipWaiting());self.addEventListener('activate',e=>self.clients.claim());`;
  const blob = new Blob([sw],{type:'text/javascript'});
  navigator.serviceWorker.register(URL.createObjectURL(blob));
}
</script>
</body>
  </html>
